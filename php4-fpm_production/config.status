s%@EXTRA_LDFLAGS@%   -L/usr/lib/gcc/x86_64-redhat-linux/16 -L/usr/local/lib -L/usr/local/pgsql/lib%g
s%@EXTRA_LDFLAGS_PROGRAM@%   -L/usr/lib/gcc/x86_64-redhat-linux/16 -L/usr/local/lib -L/usr/local/pgsql/lib%g
s%@EXTRA_LIBS@%-lssl -lcrypto -lcrypt -lresolv  -lnsl -lexpat -lcrypt -lpq -lpdf -lz -ltiff -lpng -ljpeg -lmhash -lmcrypt -lltdl -lfreetype -lpng -lz -ljpeg -lcurl -lbz2 -lz -lpcre -lm  -lgcc -lcrypt %g
s%@SAPI_EXTRA_LIBS@%/home/src/php4-fpm_production/libevent/libevent.a -lnsl -lrt -lresolv  -lxml2 -lz -llzma -lm %g
s%@SAPI_EXTRA_DEPS@%/home/src/php4-fpm_production/libevent/libevent.a%g
s%@ZEND_EXTRA_LIBS@%%g
s%@INCLUDES@% -I/usr/include/freetype2 -I/home/src/php4-fpm_production/ext/mbstring/mbregex -I/home/src/php4-fpm_production/ext/mbstring/libmbfl -I/home/src/php4-fpm_production/ext/mbstring/libmbfl/mbfl -I/usr/local/include -I/usr/local/pgsql/include -I/home/src/php4-fpm_production/ext/xml/expat -I$(top_builddir)/TSRM -I$(top_builddir)/Zend%g
s%@EXTRA_INCLUDES@%%g
s%@INSTALL_IT@%@echo "Installing PHP FPM CGI binary: $(INSTALL_ROOT)$(bindir)/"; $(INSTALL) -m 0755 $(SAPI_CGI_PATH) $(INSTALL_ROOT)$(bindir)/$(program_prefix)php-cgi$(program_suffix)$(EXEEXT)%g
s%@NATIVE_RPATHS@% -Wl,-rpath,/usr/lib/gcc/x86_64-redhat-linux/16 -Wl,-rpath,/usr/local/lib -Wl,-rpath,/usr/local/pgsql/lib%g
s%@PEAR_INSTALLDIR@%${exec_prefix}/lib/php%g
s%@PHP_LDFLAGS@% -L/usr/lib/gcc/x86_64-redhat-linux/16 -L/usr/local/lib -L/usr/local/pgsql/lib%g
