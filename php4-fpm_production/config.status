s%@CONFIGURE_COMMAND@% './configure' '--prefix=/usr/local/php4' '--without-mysql' '--enable-fastcgi' '--enable-fpm' '--with-fpm-log=/var/log/php4/php-fpm.log' '--with-fpm-pid=/run/php4/php-fpm.pid' '--with-pear' '--with-openssl' '--with-curl' '--with-mod_charset' '--with-bz2' '--with-pgsql=/usr/local/pgsql' '--with-mcrypt' '--with-mhash' '--with-pdflib=/usr/local' '--with-iconv' '--with-gd' '--with-mime-magic' '--with-xmlrpc' '--with-jpeg-dir=/usr' '--with-png-dir=/usr' '--with-freetype-dir=/usr' '--with-tiff-dir=/usr' '--with-tsrm-pthreads' '--with-gnu-ld' '--with-zlib-dir' '--with-kerberos' '--with-pcre-regex=/usr' '--enable-track-vars' '--enable-exif' '--enable-dio' '--enable-mbstring' '--enable-bcmath' '--enable-calendar' '--enable-ftp' '--enable-shmop' '--enable-sockets' '--enable-inline-optimization' '--enable-zend-multibyte' '--enable-yp' '--enable-wddx' '--enable-dbx' '--enable-gd-jis-conv' '--enable-gd-native-ttf' '--enable-mbregex' '--enable-amf' '--enable-sysvsem' '--enable-sysvshm' '--enable-sysvmsg' '--enable-versioning' '--enable-pcntl' '--enable-zip' '--enable-experimental-zts' '--enable-libgcc'%g
