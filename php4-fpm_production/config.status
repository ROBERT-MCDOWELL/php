s%@yazconfig@%%g
s%@INLINE_CFLAGS@%-g -O2 -pthread -DZTS -pthread -prefer-non-pic -static%g
s%@INCLUDE_PATH@%.:/usr/local/php4/lib/php%g
s%@EXPANDED_PEAR_INSTALLDIR@%/usr/local/php4/lib/php%g
s%@EXPANDED_EXTENSION_DIR@%/usr/local/php4/lib/php/extensions/no-debug-zts-20020429%g
