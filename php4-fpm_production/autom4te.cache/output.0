@%:@ Check whether --with-qtdom was given.
if test "${with_qtdom+set}" = set; then :
  withval=$with_qtdom; PHP_QTDOM=$withval
else
  
  PHP_QTDOM=no

  if test "$PHP_ENABLE_ALL" && test "yes" = "yes"; then
