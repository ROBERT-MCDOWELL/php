    PHP_INGRES=$PHP_ENABLE_ALL
  fi

fi



ext_output="yes, shared"
ext_shared=yes
case $PHP_INGRES in
shared,*)
  PHP_INGRES=`echo "$PHP_INGRES"|sed 's/^shared,//'`
  ;;
shared)
  PHP_INGRES=yes
  ;;
no)
  ext_output=no
  ext_shared=no
  ;;
*)
  ext_output=yes
  ext_shared=no
  ;;
esac



