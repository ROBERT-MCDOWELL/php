@%:@ Check whether --with-oracle was given.
if test "${with_oracle+set}" = set; then :
  withval=$with_oracle; PHP_ORACLE=$withval
else
  
  PHP_ORACLE=no

  if test "$PHP_ENABLE_ALL" && test "yes" = "yes"; then
    PHP_ORACLE=$PHP_ENABLE_ALL
  fi

fi



ext_output="yes, shared"
ext_shared=yes
case $PHP_ORACLE in
shared,*)
  PHP_ORACLE=`echo "$PHP_ORACLE"|sed 's/^shared,//'`
  ;;
shared)
  PHP_ORACLE=yes
  ;;
no)
  ext_output=no
  ext_shared=no
  ;;
*)
  ext_output=yes
  ext_shared=no
  ;;
esac



