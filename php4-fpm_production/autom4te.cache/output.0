shared,*)
  PHP_NCURSES=`echo "$PHP_NCURSES"|sed 's/^shared,//'`
  ;;
shared)
  PHP_NCURSES=yes
  ;;
no)
  ext_output=no
  ext_shared=no
  ;;
*)
  ext_output=yes
  ext_shared=no
  ;;
esac



