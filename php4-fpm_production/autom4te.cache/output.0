extern "C"
#endif
char gdbm_open ();
int
main ()
{
return gdbm_open ();
  ;
  return 0;
}
_ACEOF
if ac_fn_c_try_link "$LINENO"; then :
  ac_cv_lib_gdbm_gdbm_open=yes
else
