  b_cxx_meta=$php_cxx_meta
  b_c_post=$php_c_post
  b_cxx_post=$php_cxx_post
  b_lo=$php_lo


  old_IFS=$IFS
  for ac_src in gmp.c; do
  
      IFS=.
      set $ac_src
      ac_obj=$1
      IFS=$old_IFS
      
