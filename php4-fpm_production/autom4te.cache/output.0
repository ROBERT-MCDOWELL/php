    PHP_FDFTK=$PHP_ENABLE_ALL
  fi

fi



ext_output="yes, shared"
ext_shared=yes
case $PHP_FDFTK in
shared,*)
  PHP_FDFTK=`echo "$PHP_FDFTK"|sed 's/^shared,//'`
  ;;
shared)
  PHP_FDFTK=yes
  ;;
no)
  ext_output=no
  ext_shared=no
  ;;
*)
  ext_output=yes
  ext_shared=no
  ;;
esac



