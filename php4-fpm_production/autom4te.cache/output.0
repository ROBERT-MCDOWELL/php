  /*) ac_srcdir=`echo "ext/pfpro"|cut -c 2-`"/"; ac_bdir=$ac_srcdir; ac_inc="-I$ac_bdir -I$abs_srcdir/$ac_bdir" ;;
  *) ac_srcdir="$abs_srcdir/ext/pfpro/"; ac_bdir="ext/pfpro/"; ac_inc="-I$ac_bdir -I$ac_srcdir" ;;
  esac
  
  

  b_c_pre=$shared_c_pre
  b_cxx_pre=$shared_cxx_pre
  b_c_meta=$shared_c_meta
  b_cxx_meta=$shared_cxx_meta
  b_c_post=$shared_c_post
  b_cxx_post=$shared_cxx_post
  b_lo=$shared_lo


  old_IFS=$IFS
  for ac_src in pfpro.c; do
  
      IFS=.
      set $ac_src
      ac_obj=$1
      IFS=$old_IFS
      
      shared_objects_pfpro="$shared_objects_pfpro $ac_bdir$ac_obj.lo"

      case $ac_src in
	  *.c) ac_comp="$b_c_pre $ac_extra $ac_inc $b_c_meta -c $ac_srcdir$ac_src -o $ac_bdir$ac_obj.$b_lo $b_c_post" ;;
	  *.cpp|*.cc) ac_comp="$b_cxx_pre $ac_extra $ac_inc $b_cxx_meta -c $ac_srcdir$ac_src -o $ac_bdir$ac_obj.$b_lo $b_cxx_post" ;;
      esac

	  cat >>Makefile.objects<<EOF
$ac_bdir$ac_obj.lo: $ac_srcdir$ac_src
	$ac_comp
EOF
  done

      case $host_alias in
      *netware*)
       
  install_modules="install-modules"

  case $host_alias in
    *darwin*)
      suffix=so
      link_cmd='$(CC) -dynamic -flat_namespace -bundle -undefined suppress $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS) -o $@ $(EXTRA_LDFLAGS) $(shared_objects_pfpro) $(PHPPFPRO_SHARED_LIBADD)'
      ;;
    *netware*)
      suffix=nlm
      link_cmd='$(LIBTOOL) --mode=link $(CC) $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS) -o $@ -shared -export-dynamic -avoid-version -prefer-pic -module -rpath $(phplibdir) $(EXTRA_LDFLAGS) $(shared_objects_pfpro) -L$(top_builddir)/netware -lphp4lib $(PFPRO_SHARED_LIBADD)'
      ;;
    *)
      suffix=la
      link_cmd='$(LIBTOOL) --mode=link $(CC) $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS) -o $@ -export-dynamic -avoid-version -prefer-pic -module -rpath $(phplibdir) $(EXTRA_LDFLAGS) $(shared_objects_pfpro) $(PHPPFPRO_SHARED_LIBADD)'
      ;;
  esac

  PHP_MODULES="$PHP_MODULES \$(phplibdir)/phppfpro.$suffix"
  
  PHP_VAR_SUBST="$PHP_VAR_SUBST shared_objects_pfpro"

  cat >>Makefile.objects<<EOF
\$(phplibdir)/phppfpro.$suffix: $ext_builddir/phppfpro.$suffix
	\$(LIBTOOL) --mode=install cp $ext_builddir/phppfpro.$suffix \$(phplibdir)

$ext_builddir/phppfpro.$suffix: \$(shared_objects_pfpro) \$(PHPPFPRO_SHARED_DEPENDENCIES)
	$link_cmd

EOF

       ;;
      *)
       
  install_modules="install-modules"

  case $host_alias in
    *darwin*)
      suffix=so
      link_cmd='$(CC) -dynamic -flat_namespace -bundle -undefined suppress $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS) -o $@ $(EXTRA_LDFLAGS) $(shared_objects_pfpro) $(PFPRO_SHARED_LIBADD)'
      ;;
    *netware*)
      suffix=nlm
      link_cmd='$(LIBTOOL) --mode=link $(CC) $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS) -o $@ -shared -export-dynamic -avoid-version -prefer-pic -module -rpath $(phplibdir) $(EXTRA_LDFLAGS) $(shared_objects_pfpro) -L$(top_builddir)/netware -lphp4lib $(RO_SHARED_LIBADD)'
      ;;
    *)
      suffix=la
      link_cmd='$(LIBTOOL) --mode=link $(CC) $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS) $(LDFLAGS) -o $@ -export-dynamic -avoid-version -prefer-pic -module -rpath $(phplibdir) $(EXTRA_LDFLAGS) $(shared_objects_pfpro) $(PFPRO_SHARED_LIBADD)'
      ;;
  esac

  PHP_MODULES="$PHP_MODULES \$(phplibdir)/pfpro.$suffix"
  
  PHP_VAR_SUBST="$PHP_VAR_SUBST shared_objects_pfpro"

  cat >>Makefile.objects<<EOF
\$(phplibdir)/pfpro.$suffix: $ext_builddir/pfpro.$suffix
	\$(LIBTOOL) --mode=install cp $ext_builddir/pfpro.$suffix \$(phplibdir)

$ext_builddir/pfpro.$suffix: \$(shared_objects_pfpro) \$(PFPRO_SHARED_DEPENDENCIES)
	$link_cmd

EOF

      ;;
      esac
      
cat >>confdefs.h <<_ACEOF
@%:@define COMPILE_DL_PFPRO 1
_ACEOF

    fi
  fi

  if test "$ext_shared" != "shared" && test "$ext_shared" != "yes" && test "" = "cli"; then
    if test "$PHP_SAPI" = "cgi"; then
      
  
  case ext/pfpro in
  "") ac_srcdir="$abs_srcdir/"; unset ac_bdir; ac_inc="-I. -I$abs_srcdir" ;;
