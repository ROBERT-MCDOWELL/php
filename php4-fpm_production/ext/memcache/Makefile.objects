	$(LIBTOOL) --mode=compile $(CC) -I/usr/local/php4/include/php -I. -I/home/src/php4-fpm_production/ext/memcache $(COMMON_FLAGS) $(CFLAGS_CLEAN) $(EXTRA_CFLAGS)  -c /home/src/php4-fpm_production/ext/memcache/memcache.c -o memcache.lo 
